{
  "name": "obsidian-attachment-link-rules",
  "version": "0.1.1",
  "description": "Choose link or embed syntax for dropped attachments by file extension.",
  "license": "MIT",
  "author": "Viggo Meesters",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/viggomeesters/obsidian-attachment-link-rules.git"
  },
  "bugs": {
    "url": "https://github.com/viggomeesters/obsidian-attachment-link-rules/issues"
  },
  "homepage": "https://github.com/viggomeesters/obsidian-attachment-link-rules#readme",
  "type": "module",
  "scripts": {
    "build": "NODE_ENV=production node esbuild.config.mjs",
    "build:test": "esbuild src/core.ts --bundle --platform=node --format=esm --outfile=dist/core.mjs",
    "dev": "node esbuild.config.mjs",
    "lint": "node scripts/lint.mjs && eslint src/**/*.ts",
    "typecheck": "tsc --noEmit",
    "test": "npm run build:test && node --test tests/*.test.mjs",
    "sync:test-vault": "node scripts/sync-test-vault.mjs",
    "smoke:test-vault": "node scripts/smoke-test-vault.mjs",
    "community:check": "node scripts/community-check.mjs",
    "check": "npm run lint && npm run typecheck && npm test && npm run build && npm run community:check",
    "version": "node version-bump.mjs && git add manifest.json versions.json"
  },
  "devDependencies": {
    "@types/node": "^24.10.1",
    "@typescript-eslint/parser": "^8.67.0",
    "esbuild": "^0.28.2",
    "eslint": "^9.34.0",
    "eslint-plugin-obsidianmd": "^0.4.1",
    "obsidian": "^1.13.1",
    "typescript": "^5.9.3"
  }
}
